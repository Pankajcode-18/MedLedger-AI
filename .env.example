# Ethereum Sepolia Testnet Configuration
# Get your free Alchemy RPC API key from https://dashboard.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Optional: Full custom Sepolia RPC endpoint URL
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key_here

# Your Sepolia testnet private key (Do NOT commit your real private key!)
SEPOLIA_PRIVATE_KEY=your_sepolia_wallet_private_key_without_0x_prefix

# Deployed HealthRecords contract address (populated after running npm run deploy:sepolia)
HEALTH_RECORDS_CONTRACT_ADDRESS=

# Optional: Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Backend Server Port (default 8080)
PORT=8080

# JWT Authentication Secret Key
JWT_SECRET=ehr_super_secret_jwt_key_2026_sepolia_production_secure_token

# OpenAI API Key for GPT-4o Clinical AI Module
OPENAI_API_KEY=your_openai_api_key_here
