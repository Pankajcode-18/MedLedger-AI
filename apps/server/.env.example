PORT=8080
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ehr_system

# ---- Authentication ----
# Must be a private random value of 32+ characters (the server refuses to start in production otherwise).
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
# How long a sign-in lasts, e.g. 30m, 8h, 1d
JWT_EXPIRES_IN=8h
# bcrypt cost factor (12 recommended)
BCRYPT_ROUNDS=12
# Wrong passwords allowed before the account is locked, and for how long
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Requests per 15 minutes per IP to login/register/password-reset
AUTH_RATE_LIMIT=30
# Front-end origins allowed to call the API (comma separated)
CLIENT_ORIGINS=http://localhost:8081
CLIENT_URL=http://localhost:8081
# Behind nginx or a load balancer, set to 1 (number of proxies in front of the server)
# TRUST_PROXY=1
# Create the six demo accounts shown on the login page (defaults to false in production)
DEMO_ACCOUNTS=true
# No email service is configured: return the password-reset token in the API response (never in production)
EXPOSE_RESET_TOKEN=true

# ---- Encrypted storage ----
# Master key that protects every record's own AES-256-GCM key. 64 hex characters. REQUIRED in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it (development only) a key is generated once in .medledger-master.key next to state.json —
# back that file up: records cannot be decrypted without it.
MASTER_ENCRYPTION_KEY=
# After a rotation, list old keys here (comma separated) until `npm run keys:rotate` reports 0 left
MASTER_ENCRYPTION_KEYS_PREVIOUS=
# auto = MongoDB GridFS when connected, otherwise the local encrypted-files folder; or force gridfs / local
FILE_STORAGE_BACKEND=auto
# Folder for encrypted files when MongoDB is not used (default: encrypted-files next to state.json)
# FILE_STORAGE_DIR=
UPLOAD_MAX_MB=25

# ---- MetaMask wallet ----
# Network MetaMask should use: 11155111 = Sepolia test network, 31337 = local Hardhat node (npx hardhat node)
WALLET_CHAIN_ID=11155111
# Public RPC MetaMask may add for that network (optional; never put a URL containing a private key here)
# WALLET_PUBLIC_RPC_URL=https://rpc.sepolia.org
WALLET_CHALLENGE_MINUTES=5

# ---- Record history on Ethereum (HealthRecords contract) ----
# Leave these empty to keep the record history on this server only.
# Set all three to also write every upload and sharing change to the contract:
#   local chain : npm run chain:node, then npm run deploy:local (fills these in for you)
#   Sepolia     : npm run deploy:sepolia, then set the RPC URL and the key of the deploying account
HEALTH_RECORDS_CONTRACT_ADDRESS=
# RPC the server sends transactions through (e.g. https://eth-sepolia.g.alchemy.com/v2/<key>, or http://127.0.0.1:8545)
CHAIN_RPC_URL=
# Private key of the server account that deployed the contract (its "relayer"). Keep it secret; fund it with a little Sepolia ETH.
CHAIN_PRIVATE_KEY=
# auto = use the contract when all three are set; simulated = never write to a chain
BLOCKCHAIN_MODE=auto

# ---- Reading uploaded files (PDF text + OCR) ----
# Scanned PDFs and photos of reports are read with Tesseract OCR on this server (nothing is sent out).
OCR_ENABLED=true
# English is built in and works offline. Add Nepali with eng+nep (downloaded once, or put nep.traineddata in OCR_LANG_PATH)
OCR_LANGUAGES=eng
# OCR_LANG_PATH=
# Scanned pages read per document, and the time allowed for each page
OCR_MAX_PAGES=15
OCR_PAGE_TIMEOUT_MS=60000

# ---- AI module ----
# Optional. Without a key (or with this placeholder) the built-in clinical engine is used and no data leaves the server.
# With a key, only de-identified text is sent to OpenAI. Enable Zero Data Retention in your OpenAI settings (Guide §7.3).
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_CHAT_MODEL=gpt-4o-mini
# Fall back to the built-in engine if OpenAI takes longer than this
AI_TIMEOUT_MS=15000
# AI requests per minute per IP
AI_RATE_LIMIT_PER_MIN=30
HEALTH_RECORDS_CONTRACT_ADDRESS=
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
